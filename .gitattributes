# A text-merged .meta can end up with conflict markers, which Unity treats as a
# corrupt importer file and rewrites with a freshly generated GUID -- silently
# dangling every reference to that asset. Conflict instead: git leaves our copy
# in place and flags it, so a human picks a side. Verified by Tools/validate_guid_refs.py.
*.meta merge=binary

*.unity merge=unityyamlmerge
*.prefab merge=unityyamlmerge
*.asset merge=unityyamlmerge
*.mat merge=unityyamlmerge
*.physicMaterial merge=unityyamlmerge
*.physicsMaterial2D merge=unityyamlmerge
*.anim merge=unityyamlmerge
*.controller merge=unityyamlmerge
*.mask merge=unityyamlmerge
*.overrideController merge=unityyamlmerge
*.so filter=lfs diff=lfs merge=lfs -text
